<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cálculo de IMC</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            width: 350px;
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,.1);
        }

        h1 {
            text-align: center;
        }

        label {
            display: block;
            margin-top: 10px;
        }

        input {
            width: 100%;
            padding: 8px;
            margin-top: 5px;
            box-sizing: border-box;
        }

        button {
            width: 100%;
            margin-top: 20px;
            padding: 10px;
            border: none;
            background-color: #007bff;
            color: white;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }

        .result {
            margin-top: 16px;
            padding: 12px;
            border-radius: 6px;
            background: #f5f5f5;
        }

        .result.success {
            border: 1px solid #28a745;
            color: #155724;
            background: #d4edda;
        }

        .result.error {
            border: 1px solid #dc3545;
            color: #721c24;
            background: #f8d7da;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Calculadora IMC</h1>

        <form action="#" method="POST">

            <label for="altura">Altura (m)</label>
            <input
                type="number"
                id="altura"
                name="altura"
                step="0.01"
                placeholder="Ex: 1.75"
                required>

            <label for="peso">Peso (kg)</label>
            <input
                type="number"
                id="peso"
                name="peso"
                step="0.1"
                placeholder="Ex: 70"
                required>

            <button type="submit" id="calcular">
                Calcular IMC
            </button>

        </form>
        <div id="result" class="result"></div>
    </div>

</body>
<script>
    const apiUrl = '<%= apiUrl %>';
    const form = document.querySelector('form');
    const resultDiv = document.querySelector('#result');

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        resultDiv.textContent = '';

        const altura = parseFloat(document.querySelector('#altura').value.replace(',', '.'));
        const peso = parseFloat(document.querySelector('#peso').value.replace(',', '.'));

        if (!altura || !peso || altura <= 0 || peso <= 0) {
            resultDiv.textContent = 'Informe altura e peso válidos.';
            resultDiv.className = 'result error';
            return;
        }

        try {
            const response = await fetch(`${apiUrl}/imc`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ altura, peso })
            });

            const data = await response.json();

            if (!response.ok) {
                resultDiv.textContent = data.error || 'Erro ao calcular IMC.';
                resultDiv.className = 'result error';
                return;
            }

            resultDiv.innerHTML = `
                <p>IMC: <strong>${data.imc.toFixed(2)}</strong></p>
                <p>${data.classificacao}</p>
            `;
            resultDiv.className = 'result success';
        } catch (error) {
            resultDiv.textContent = 'Não foi possível conectar à API.';
            resultDiv.className = 'result error';
        }
    });
</script>
</html>